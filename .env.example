# DeepSeek / 兼容网关
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# 硅基流动
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1


# YOLO
RICE_YOLO_MODEL_PATH=./models/YOLO11L-Rice-Disease-Detection.pt
YOLO_DEVICE=auto
YOLO_IMAGE_SIZE=640
YOLO_CONFIDENCE=0.25
YOLO_IOU=0.45
MAX_DETECTION_BOXES_FOR_LLM=80

# RAG
EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu
RAG_TOP_K=4
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=80
RAG_PRECISE_THRESHOLD=0.78
RAG_REFERENCE_THRESHOLD=0.45
RAG_MIN_PRECISE_CHUNKS=1

# Agent
MAX_AGENT_STEPS=10
MAX_TOOL_RESULT_CHARS=30000
CHAT_WINDOW_TURNS=6
CHAT_MAX_HISTORY_CHARS=12000
HALLUCINATION_TARGET=0.90
HALLUCINATION_MAX_RETRIES=2

# Web / 评估
MAX_UPLOAD_MB=8
EVALUATION_ENABLED=true
EVALUATION_TIMEOUT_SECONDS=45
