# DeepSeek / 兼容网关
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# 硅基流动
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1


# YOLO
RICE_YOLO_MODEL_PATH=./models/YOLO11L-Rice-Disease-Detection.pt
YOLO_DEVICE=auto
YOLO_IMAGE_SIZE=640
YOLO_CONFIDENCE=0.25
YOLO_IOU=0.45
MAX_DETECTION_BOXES_FOR_LLM=80

# RAG
EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu
# 首次下载保持 false；模型已缓存且需完全离线时改为 true
EMBEDDING_LOCAL_FILES_ONLY=false
EMBEDDING_QUERY_PROMPT=
EMBEDDING_BENCHMARK_MODELS=BAAI/bge-small-zh-v1.5,BAAI/bge-base-zh-v1.5,BAAI/bge-large-zh-v1.5,BAAI/bge-m3,Qwen/Qwen3-Embedding-0.6B
KNOWLEDGE_CORPUS_DIR=./knowledge/corpus/pmc
KNOWLEDGE_TARGET_MB=10
EUROPE_PMC_EMAIL=
RAG_TOP_K=4
RAG_CANDIDATE_TOP_K=8
RAG_FUSION_TOP_K=20
RAG_FINAL_TOP_K=4
RRF_K=60
MULTI_QUERY_COUNT=3
QUERY_ENHANCEMENT_ENABLED=true
HYDE_ENABLED=true
RERANKER_ENABLED=true
RERANKER_MODEL_NAME=BAAI/bge-reranker-base
RERANKER_DEVICE=cpu
RERANKER_BATCH_SIZE=8
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=80
RAG_PARENT_CHUNK_TOKENS=500
RAG_PARENT_OVERLAP_TOKENS=50
RAG_CHILD_CHUNK_TOKENS=150
RAG_CHILD_OVERLAP_TOKENS=25
RAG_TOKENIZER_MODEL_NAME=
RAG_PRECISE_THRESHOLD=0.78
RAG_REFERENCE_THRESHOLD=0.45
RAG_MIN_PRECISE_CHUNKS=1

# Agent
MAX_AGENT_STEPS=10
MAX_TOOL_RESULT_CHARS=30000
CHAT_WINDOW_TURNS=6
CHAT_MAX_HISTORY_CHARS=12000
HALLUCINATION_TARGET=0.90
HALLUCINATION_MAX_RETRIES=2

# Web / 评估
MAX_UPLOAD_MB=8
EVALUATION_ENABLED=true
EVALUATION_TIMEOUT_SECONDS=45
